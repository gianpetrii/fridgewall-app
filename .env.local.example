# Copia este archivo a .env.local y completá los valores
# cp .env.local.example .env.local

# Firebase — Project Settings → General → Your apps → Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Sign-In — Web client ID: Authentication → Sign-in method → Google → Web SDK configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Google Sign-In — iOS client ID: CLIENT_ID en GoogleService-Info.plist
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android — Firebase Console → Project Settings → Add app (Android)
# Package name: com.fridgewall.app → descargar google-services.json en la raíz del proyecto
# EAS Build: eas secret:create --scope project --name GOOGLE_SERVICES_JSON --type file --value ./google-services.json
# Después del primer build de producción, agregar SHA-1 de EAS en Firebase (ver README o guía Play Store)
